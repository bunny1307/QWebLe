# ============================================================
# FLASK & SECURITY
# ============================================================
FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-werkzeug-generated-password-hash
COOKIE_SECURE=true
MAX_REQUEST_MB=50
TAX_PERCENTAGE=5

# ============================================================
# AWS RDS / MYSQL DATABASE CONFIGURATION
# ============================================================
# Option 1: Individual RDS Parameters (Recommended on Render)
MYSQL_HOST=your-rds-endpoint.c123456789.us-east-1.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_DATABASE=qsr
MYSQL_USER=admin
MYSQL_PASSWORD=your-secure-rds-password
MYSQL_CONNECT_TIMEOUT=10
MYSQL_SSL_DISABLED=false

# Option 2: Full Connection String URL
# DATABASE_URL=mysql://admin:your-secure-rds-password@your-rds-endpoint.c123456789.us-east-1.rds.amazonaws.com:3306/qsr

# ============================================================
# RENDER SERVER BINDING & CORS
# ============================================================
# Render automatically sets PORT. Locally default is 5000.
PORT=5000
BIND_HOST=0.0.0.0

# Allowed Frontend Origins for CORS (Netlify URL or '*' for all)
CORS_ALLOWED_ORIGINS=*
# Example for specific Netlify domain:
# CORS_ALLOWED_ORIGINS=https://my-qsr-app.netlify.app

# ============================================================
# PAYMENT GATEWAY (RAZORPAY)
# ============================================================
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
